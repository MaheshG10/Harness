# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model aliases always point at the current Flash / Flash-Lite release.
# Pin an exact model ID here when you run the final experiments.
HARNESS_MODEL=gemini-flash-latest

# Free tier limits are per project. Check yours in AI Studio and set them here.
HARNESS_RPM=10
HARNESS_TPM=250000
HARNESS_RPD=250
